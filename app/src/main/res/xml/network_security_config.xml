<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strictly disallow cleartext HTTP traffic across the entire application -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Only trust valid system CA certificates, blocking user-installed rogue certs -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Specific domain rules for Google APIs, Firebase, and Search services -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">firebaseio.com</domain>
        <domain includeSubdomains="true">google.com</domain>
        <domain includeSubdomains="true">duckduckgo.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
